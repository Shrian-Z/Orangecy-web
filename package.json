    "check": "npm run typecheck && vite build",
    "catalog": "node scripts/build-catalog.mjs",
    "catalog:cross": "node scripts/build-cross-catalog.mjs",
    "cards": "node scripts/build-cards.mjs",
    "check:cards": "node scripts/check-cards.mjs",
    "check:palette": "node scripts/check-palette.mjs",
    "smoke": "node scripts/smoke.mjs",
    "trace:audio": "node scripts/trace-audio.mjs",
    "accept:import": "node scripts/import-gaokao.mjs",
    "shoot:focus": "node scripts/shoot-focus.mjs",
    "shoot:nav": "node scripts/shoot-nav.mjs"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "^4.41.1",
    "@yakult-green-tea/qq-music-api": "^3.3.3",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "kugoumusicapi": "https://github.com/MakcRe/KuGouMusicApi/archive/refs/tags/v1.6.0.tar.gz",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^5.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
